/* =========================================
   PALETTE
========================================= */

/*
   Beige principal  : #F5EBDD
   Beige clair      : #FBF7F2
   Beige foncé      : #E5D3C0

   Bordeaux         : #7A2638
   Bordeaux foncé   : #5A1B29

   Noir             : #1E1E1E
*/


/* =========================================
   RÉGLAGES GÉNÉRAUX
========================================= */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;

  /* Fond beige */
  background-color: #F5EBDD;

  /* Texte noir */
  color: #1E1E1E;

  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}


/* =========================================
   MENU
========================================= */

.header {
  position: sticky;
  top: 0;
  z-index: 100;

  background-color: rgba(245, 235, 221, 0.97);

  border-bottom: 1px solid #E5D3C0;
}

.navbar {
  max-width: 1200px;
  margin: auto;

  padding: 18px 30px;

  display: flex;
  justify-content: space-between;
  align-items: center;
}


/* Logo */

.logo {
  font-family: Georgia, serif;

  font-size: 1.8rem;

  font-weight: bold;

  color: #7A2638;
}


/* Liens du menu */

.nav-links {
  display: flex;
  gap: 25px;
}

.nav-links a {
  color: #1E1E1E;

  font-size: 0.9rem;

  transition: 0.3s;
}

.nav-links a:hover {
  color: #7A2638;
}


/* =========================================
   ACCUEIL
========================================= */

.hero {
  max-width: 1200px;

  min-height: 700px;

  margin: auto;

  padding: 90px 30px;

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 80px;
}

.hero-text {
  max-width: 650px;
}


/* Petit titre */

.small-title {
  color: #7A2638;

  font-size: 0.8rem;

  font-weight: bold;

  letter-spacing: 3px;

  margin-bottom: 20px;
}


/* Grand titre */

h1 {
  font-family: Georgia, serif;

  font-size: clamp(2.5rem, 6vw, 5rem);

  line-height: 1.05;

  margin-bottom: 30px;
}


/* "Bonjour, je suis" */

.red-title {
  color: #7A2638;
}


/* "Vinciane LAVILLE" */

.green-title {
  color: #7A2638;
}


/* Description */

.hero-description {
  max-width: 580px;

  font-size: 1.1rem;

  color: #1E1E1E;

  margin-bottom: 35px;
}


/* =========================================
   BOUTONS
========================================= */

.buttons {
  display: flex;

  gap: 15px;

  flex-wrap: wrap;
}

.button {
  display: inline-block;

  padding: 14px 24px;

  border-radius: 4px;

  font-weight: bold;

  cursor: pointer;

  transition: 0.3s;
}


/* Bouton bordeaux */

.button-green {
  background-color: #7A2638;

  color: white;
}

.button-green:hover {
  background-color: #5A1B29;

  transform: translateY(-2px);
}


/* Bouton contour */

.button-outline {
  border: 1px solid #7A2638;

  color: #7A2638;
}

.button-outline:hover {
  background-color: #7A2638;

  color: white;
}


/* =========================================
   PHOTO
========================================= */

.photo-container {
  position: relative;

  width: 320px;

  height: 400px;

  flex-shrink: 0;
}


/* Cadre décoratif */

.photo-decoration {
  position: absolute;

  width: 100%;

  height: 100%;

  border: 2px solid #7A2638;

  top: 18px;

  left: 18px;

  z-index: 0;
}


/* Photo */

.profile-photo {
  position: relative;

  width: 100%;

  height: 100%;

  object-fit: cover;

  background-color: #E5D3C0;

  border: 8px solid #FBF7F2;

  box-shadow:
    0 15px 35px rgba(90, 27, 41, 0.18);

  z-index: 2;
}


/* Texte avant l'ajout de la photo */

.photo-message {
  position: absolute;

  top: 50%;

  left: 50%;

  transform: translate(-50%, -50%);

  color: #7A2638;

  font-family: Georgia, serif;

  text-align: center;

  z-index: 1;
}


/* =========================================
   SECTIONS
========================================= */

.section {
  max-width: 1200px;

  margin: auto;

  padding: 100px 30px;
}


/* Sections beige plus foncé */

.beige-section {
  max-width: none;

  padding-left:
    max(30px, calc((100% - 1200px) / 2));

  padding-right:
    max(30px, calc((100% - 1200px) / 2));

  background-color: #E5D3C0;
}


/* =========================================
   TITRES DES SECTIONS
========================================= */

.section-title {
  margin-bottom: 55px;
}

.section-title p {
  color: #7A2638;

  font-size: 0.75rem;

  letter-spacing: 3px;

  font-weight: bold;

  margin-bottom: 8px;
}


/* Tous les titres en bordeaux */

.section-title h2 {
  font-family: Georgia, serif;

  color: #7A2638;

  font-size: 2.7rem;
}


/* =========================================
   À PROPOS
========================================= */

.about-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;
}


/* Cartes */

.info-card {
  background-color: #FBF7F2;

  padding: 35px;

  border: 1px solid #E5D3C0;

  transition: 0.3s;
}

.info-card:hover {
  transform: translateY(-5px);

  box-shadow:
    0 15px 30px rgba(90, 27, 41, 0.10);
}


/* Numéros */

.info-card span {
  color: #7A2638;

  font-weight: bold;

  font-size: 0.8rem;
}


/* Titres des cartes */

.info-card h3 {
  margin: 15px 0;

  color: #7A2638;

  font-family: Georgia, serif;

  font-size: 1.4rem;
}


/* Texte noir */

.info-card p {
  color: #1E1E1E;
}


/* =========================================
   COMPÉTENCES
========================================= */

.skills-container {
  max-width: 850px;
}

.skill {
  margin-bottom: 30px;
}

.skill-header {
  display: flex;

  justify-content: space-between;

  margin-bottom: 8px;

  color: #1E1E1E;

  font-weight: bold;
}

.skill-bar {
  width: 100%;

  height: 8px;

  background-color: #D8C1AF;

  overflow: hidden;
}


/* Barres bordeaux */

.skill-progress {
  height: 100%;

  background-color: #7A2638;
}

.progress-85 {
  width: 85%;
}

.progress-80 {
  width: 80%;
}

.progress-90 {
  width: 90%;
}

.progress-88 {
  width: 88%;
}


/* =========================================
   PARCOURS
========================================= */

.timeline {
  max-width: 850px;

  border-left: 2px solid #7A2638;

  padding-left: 35px;
}

.timeline-item {
  position: relative;

  margin-bottom: 45px;
}


/* Petits ronds bordeaux */

.timeline-item::before {
  content: "";

  position: absolute;

  width: 12px;

  height: 12px;

  border-radius: 50%;

  background-color: #7A2638;

  left: -42px;

  top: 5px;
}


/* Dates */

.timeline-date {
  color: #7A2638;

  font-weight: bold;

  margin-bottom: 8px;
}


/* Titres */

.timeline-content h3 {
  color: #7A2638;

  font-family: Georgia, serif;

  font-size: 1.4rem;

  margin-bottom: 5px;
}


/* Texte noir */

.timeline-content p {
  color: #1E1E1E;
}


/* =========================================
   PROJETS
========================================= */

.projects-grid {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 25px;
}

.project-card {
  background-color: #FBF7F2;

  padding: 45px;

  border: 1px solid #E5D3C0;

  position: relative;

  transition: 0.3s;
}

.project-card:hover {
  transform: translateY(-5px);

  box-shadow:
    0 15px 30px rgba(90, 27, 41, 0.10);
}


/* Numéro */

.project-number {
  color: #7A2638;

  font-size: 0.85rem;

  font-weight: bold;
}


/* Titre projet */

.project-card h3 {
  color: #7A2638;

  font-family: Georgia, serif;

  font-size: 1.8rem;

  margin: 20px 0 15px;
}


/* Texte noir */

.project-card p {
  color: #1E1E1E;

  margin-bottom: 25px;
}


/* Étiquettes */

.tags {
  display: flex;

  gap: 8px;

  flex-wrap: wrap;
}

.tags span {
  padding: 6px 12px;

  background-color: #E5D3C0;

  color: #7A2638;

  font-size: 0.75rem;

  border-radius: 20px;
}


/* =========================================
   CITATION
========================================= */

.quote-section {
  background-color: #7A2638;

  color: white;

  padding: 100px 30px;

  text-align: center;
}

.quote {
  max-width: 750px;

  margin: auto;
}

.quote-mark {
  font-family: Georgia, serif;

  font-size: 5rem;

  color: #E5D3C0;

  line-height: 0;
}

.quote p {
  font-family: Georgia, serif;

  font-size: 2rem;

  margin: 20px 0 25px;
}

.quote-line {
  display: block;

  width: 50px;

  height: 2px;

  background-color: #E5D3C0;

  margin: auto;
}

.quote small {
  display: block;

  margin-top: 15px;

  color: #F5EBDD;
}


/* =========================================
   CONTACT
========================================= */

.contact-section {
  padding-bottom: 120px;
}

.contact-box {
  background-color: #E5D3C0;

  padding: 50px;

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 30px;
}


/* Titre bordeaux */

.contact-box h3 {
  font-family: Georgia, serif;

  color: #7A2638;

  font-size: 1.8rem;

  margin-bottom: 10px;
}


/* Texte noir */

.contact-box p {
  color: #1E1E1E;
}


/* =========================================
   FOOTER
========================================= */

footer {
  background-color: #5A1B29;

  color: #F5EBDD;

  text-align: center;

  padding: 25px;

  font-size: 0.85rem;
}


/* =========================================
   RESPONSIVE
========================================= */

@media (max-width: 900px) {

  .hero {
    flex-direction: column;

    text-align: center;

    padding-top: 70px;
  }

  .hero-description {
    margin-left: auto;

    margin-right: auto;
  }

  .buttons {
    justify-content: center;
  }

  .about-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .nav-links {
    gap: 12px;
  }
}


@media (max-width: 650px) {

  .navbar {
    flex-direction: column;

    gap: 15px;
  }

  .nav-links {
    flex-wrap: wrap;

    justify-content: center;
  }

  .hero {
    padding: 60px 20px;
  }

  .photo-container {
    width: 260px;

    height: 330px;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .projects-grid {
    grid-template-columns: 1fr;
  }

  .contact-box {
    flex-direction: column;

    align-items: flex-start;
  }

  .quote p {
    font-size: 1.5rem;
  }

  .section {
    padding: 70px 20px;
  }
}
