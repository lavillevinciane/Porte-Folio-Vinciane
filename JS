/* ================================
   RÉGLAGES GÉNÉRAUX
================================ */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: Arial, sans-serif;
  background-color: #f6f0e8;
  color: #29231f;
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}


/* ================================
   MENU
================================ */

.header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: rgba(246, 240, 232, 0.96);
  border-bottom: 1px solid #dfd1c2;
}

.navbar {
  max-width: 1200px;
  margin: auto;
  padding: 18px 30px;

  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-family: Georgia, serif;
  font-size: 1.8rem;
  font-weight: bold;
  color: #315c4c;
}

.nav-links {
  display: flex;
  gap: 25px;
}

.nav-links a {
  color: #6b3f28;
  font-size: 0.9rem;
  transition: 0.3s;
}

.nav-links a:hover {
  color: #8b2e2e;
}


/* ================================
   ACCUEIL
================================ */

.hero {
  max-width: 1200px;
  min-height: 700px;
  margin: auto;
  padding: 90px 30px;

  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 80px;
}

.hero-text {
  max-width: 650px;
}

.small-title {
  color: #b28a5b;
  font-size: 0.8rem;
  font-weight: bold;
  letter-spacing: 3px;
  margin-bottom: 20px;
}

h1 {
  font-family: Georgia, serif;
  font-size: clamp(2.5rem, 6vw, 5rem);
  line-height: 1.05;
  margin-bottom: 30px;
}

.red-title {
  color: #8b2e2e;
}

.green-title {
  color: #315c4c;
}

.hero-description {
  max-width: 580px;
  font-size: 1.1rem;
  color: #6b625c;
  margin-bottom: 35px;
}

.buttons {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.button {
  display: inline-block;
  padding: 14px 24px;
  border-radius: 3px;
  font-weight: bold;
  cursor: pointer;
  transition: 0.3s;
}

.button-green {
  background-color: #315c4c;
  color: white;
}

.button-green:hover {
  background-color: #24483b;
  transform: translateY(-2px);
}

.button-outline {
  border: 1px solid #6b3f28;
  color: #6b3f28;
}

.button-outline:hover {
  background-color: #6b3f28;
  color: white;
}


/* ================================
   PHOTO
================================ */

.photo-container {
  position: relative;
  width: 320px;
  height: 400px;
  flex-shrink: 0;
}

.photo-decoration {
  position: absolute;

  width: 100%;
  height: 100%;

  border: 2px solid #b28a5b;

  top: 18px;
  left: 18px;

  z-index: 0;
}

.profile-photo {
  position: relative;

  width: 100%;
  height: 100%;

  object-fit: cover;

  background-color: #e7ddd1;

  border: 8px solid #f6f0e8;

  box-shadow: 0 15px 35px rgba(63, 42, 30, 0.18);

  z-index: 2;
}

/* Message affiché avant de choisir une photo */
.photo-message {
  position: absolute;

  top: 50%;
  left: 50%;

  transform: translate(-50%, -50%);

  color: #6b3f28;

  font-family: Georgia, serif;

  text-align: center;

  z-index: 1;
}


/* ================================
   SECTIONS
================================ */

.section {
  max-width: 1200px;
  margin: auto;
  padding: 100px 30px;
}

.beige-section {
  max-width: none;
  padding-left: max(30px, calc((100% - 1200px) / 2));
  padding-right: max(30px, calc((100% - 1200px) / 2));

  background-color: #eee4d8;
}

.section-title {
  margin-bottom: 55px;
}

.section-title p {
  color: #b28a5b;
  font-size: 0.75rem;
  letter-spacing: 3px;
  font-weight: bold;
  margin-bottom: 8px;
}

.section-title h2 {
  font-family: Georgia, serif;
  color: #315c4c;
  font-size: 2.7rem;
}


/* ================================
   À PROPOS
================================ */

.about-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;
}

.info-card {
  background-color: #fffaf4;

  padding: 35px;

  border: 1px solid #dfd1c2;

  transition: 0.3s;
}

.info-card:hover {
  transform: translateY(-5px);

  box-shadow: 0 15px 30px rgba(63, 42, 30, 0.08);
}

.info-card span {
  color: #b28a5b;
  font-weight: bold;
  font-size: 0.8rem;
}

.info-card h3 {
  margin: 15px 0;
  color: #6b3f28;
  font-family: Georgia, serif;
  font-size: 1.4rem;
}

.info-card p {
  color: #6b625c;
}


/* ================================
   COMPÉTENCES
================================ */

.skills-container {
  max-width: 850px;
}

.skill {
  margin-bottom: 30px;
}

.skill-header {
  display: flex;
  justify-content: space-between;

  margin-bottom: 8px;

  color: #6b3f28;
  font-weight: bold;
}

.skill-bar {
  width: 100%;
  height: 8px;

  background-color: #d8cbbd;

  overflow: hidden;
}

.skill-progress {
  height: 100%;
  background-color: #315c4c;
}

.progress-85 {
  width: 85%;
}

.progress-80 {
  width: 80%;
}

.progress-90 {
  width: 90%;
}

.progress-88 {
  width: 88%;
}


/* ================================
   PARCOURS
================================ */

.timeline {
  max-width: 850px;
  border-left: 2px solid #b28a5b;
  padding-left: 35px;
}

.timeline-item {
  position: relative;
  margin-bottom: 45px;
}

.timeline-item::before {
  content: "";

  position: absolute;

  width: 12px;
  height: 12px;

  border-radius: 50%;

  background-color: #315c4c;

  left: -42px;
  top: 5px;
}

.timeline-date {
  color: #b28a5b;
  font-weight: bold;
  margin-bottom: 8px;
}

.timeline-content h3 {
  color: #6b3f28;
  font-family: Georgia, serif;
  font-size: 1.4rem;
  margin-bottom: 5px;
}

.timeline-content p {
  color: #6b625c;
}


/* ================================
   PROJETS
================================ */

.projects-grid {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 25px;
}

.project-card {
  background-color: #fffaf4;

  padding: 45px;

  border: 1px solid #dfd1c2;

  position: relative;

  transition: 0.3s;
}

.project-card:hover {
  transform: translateY(-5px);

  box-shadow: 0 15px 30px rgba(63, 42, 30, 0.08);
}

.project-number {
  color: #b28a5b;
  font-size: 0.85rem;
  font-weight: bold;
}

.project-card h3 {
  color: #315c4c;

  font-family: Georgia, serif;

  font-size: 1.8rem;

  margin: 20px 0 15px;
}

.project-card p {
  color: #6b625c;
  margin-bottom: 25px;
}

.tags {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.tags span {
  padding: 6px 12px;

  background-color: #eee4d8;

  color: #6b3f28;

  font-size: 0.75rem;

  border-radius: 20px;
}


/* ================================
   CITATION
================================ */

.quote-section {
  background-color: #315c4c;

  color: white;

  padding: 100px 30px;

  text-align: center;
}

.quote {
  max-width: 750px;
  margin: auto;
}

.quote-mark {
  font-family: Georgia, serif;

  font-size: 5rem;

  color: #b28a5b;

  line-height: 0;
}

.quote p {
  font-family: Georgia, serif;

  font-size: 2rem;

  margin: 20px 0 25px;
}

.quote-line {
  display: block;

  width: 50px;
  height: 2px;

  background-color: #b28a5b;

  margin: auto;
}

.quote small {
  display: block;

  margin-top: 15px;

  color: #dfd1c2;
}


/* ================================
   CONTACT
================================ */

.contact-section {
  padding-bottom: 120px;
}

.contact-box {
  background-color: #eee4d8;

  padding: 50px;

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 30px;
}

.contact-box h3 {
  font-family: Georgia, serif;

  color: #6b3f28;

  font-size: 1.8rem;

  margin-bottom: 10px;
}

.contact-box p {
  color: #6b625c;
}


/* ================================
   FOOTER
================================ */

footer {
  background-color: #29231f;

  color: #d8cbbd;

  text-align: center;

  padding: 25px;

  font-size: 0.85rem;
}


/* ================================
   RESPONSIVE
   Pour tablette et téléphone
================================ */

@media (max-width: 900px) {

  .hero {
    flex-direction: column;

    text-align: center;

    padding-top: 70px;
  }

  .hero-description {
    margin-left: auto;
    margin-right: auto;
  }

  .buttons {
    justify-content: center;
  }

  .about-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .nav-links {
    gap: 12px;
  }
}


@media (max-width: 650px) {

  .navbar {
    flex-direction: column;
    gap: 15px;
  }

  .nav-links {
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero {
    padding: 60px 20px;
  }

  .photo-container {
    width: 260px;
    height: 330px;
  }

  .about-grid {
    grid-template-columns: 1fr;
  }

  .projects-grid {
    grid-template-columns: 1fr;
  }

  .contact-box {
    flex-direction: column;

    align-items: flex-start;
  }

  .quote p {
    font-size: 1.5rem;
  }

  .section {
    padding: 70px 20px;
  }

}
